#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    subLayers = [
        @Terrain.usdc@,
        @Rocks.usdc@,
        @Astronaut.usdc@,
        @Camera.usdc@,
        @Lights.usdc@,
        @Looks.usdc@
    ]
    upAxis = "Y"
)

over "World"
{
    over "Terrain" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/Sandstone>
    }

    over "Rocks" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/Sandstone>
    }

    over "Astronaut" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/Expedition_Suit>
    }

    over "Lights" (
        prepend apiSchemas = ["CollectionAPI:ShotLights"]
    )
    {
        rel collection:ShotLights:includes = [
            </World/Lights/Sun>,
            </World/Lights/Sky>,
        ]
    }
}

def Scope "Render"
{
    def Scope "Products"
    {
        def Scope "Vars"
        {
            def RenderVar "Beauty" (
                apiSchemas = ["KarmaRenderVarAPI"]
                customData = {
                    int[] HoudiniPrimEditorNodes = [4411]
                }
            )
            {
                uniform token dataType = "color4f" (
                    customData = {
                        int[] HoudiniPrimEditorNodes = [4411]
                    }
                )
                custom int driver:parameters:aov:clearValue = 0 (
                    customData = {
                        int[] HoudiniPrimEditorNodes = [4411]
                    }
                )
                custom token driver:parameters:aov:format = "color4h" (
                    customData = {
                        int[] HoudiniPrimEditorNodes = [4411]
                    }
                )
                string driver:parameters:aov:karma:filter = '["ubox",{}]' (
                    customData = {
                        int[] HoudiniPrimEditorNodes = [4411]
                    }
                )
                custom bool driver:parameters:aov:multiSampled = 1 (
                    customData = {
                        int[] HoudiniPrimEditorNodes = [4411]
                    }
                )
                custom string driver:parameters:aov:name = "C" (
                    customData = {
                        int[] HoudiniPrimEditorNodes = [4411]
                    }
                )
                uniform string sourceName = "C.*[LO]" (
                    customData = {
                        int[] HoudiniPrimEditorNodes = [4411]
                    }
                )
                uniform token sourceType = "lpe" (
                    customData = {
                        int[] HoudiniPrimEditorNodes = [4411]
                    }
                )
            }
        }

        def RenderProduct "renderproduct" (
            apiSchemas = ["HuskRenderProductAPI"]
            customData = {
                int[] HoudiniPrimEditorNodes = [4233, 4262]
            }
        )
        {
            string driver:parameters:husk:artist = "" (
                customData = {
                    int[] HoudiniPrimEditorNodes = [4233]
                }
            )
            string driver:parameters:husk:comment = "" (
                customData = {
                    int[] HoudiniPrimEditorNodes = [4233]
                }
            )
            string driver:parameters:husk:hostname = "" (
                customData = {
                    int[] HoudiniPrimEditorNodes = [4233]
                }
            )
            string driver:parameters:husk:OpenEXR:compression = "zips" (
                customData = {
                    int[] HoudiniPrimEditorNodes = [4233]
                }
            )
            rel orderedVars = </Render/Products/Vars/Beauty>
            token productName = "Dawning_Rocks.exr" (
                customData = {
                    int[] HoudiniPrimEditorNodes = [4233]
                }
            )
            uniform token productType = "raster" (
                customData = {
                    int[] HoudiniPrimEditorNodes = [4233]
                }
            )
        }
    }

    def RenderSettings "rendersettings" (
        apiSchemas = ["KarmaRenderSettingsAPI"]
        customData = {
            int[] HoudiniPrimEditorNodes = [4241]
        }
    )
    {
        uniform token aspectRatioConformPolicy = "expandAperture" (
            customData = {
                int[] HoudiniPrimEditorNodes = [4241]
            }
        )
        rel camera = </World/Cameras/Shot>
        uniform float4 dataWindowNDC = (0, 0, 1, 1) (
            customData = {
                int[] HoudiniPrimEditorNodes = [4241]
            }
        )
        uniform bool disableDepthOfField = 0 (
            customData = {
                int[] HoudiniPrimEditorNodes = [4241]
            }
        )
        uniform bool disableMotionBlur = 0 (
            customData = {
                int[] HoudiniPrimEditorNodes = [4241]
            }
        )
        uniform token[] includedPurposes = ["default", "render"] (
            customData = {
                int[] HoudiniPrimEditorNodes = [4241]
            }
        )
        bool karma:global:abortmissingtexture = 0 (
            customData = {
                int[] HoudiniPrimEditorNodes = [4241]
            }
        )
